# Claude Code API Key
# Get your API key from: https://console.anthropic.com/
CLAUDE_CODE_API_KEY=your_api_key_here

# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production

# Ollama Configuration (optional)
OLLAMA_BASE_URL=http://localhost:11434

# File Upload Configuration (optional)
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=uploads

# Local-only mode (default true): use only local Ollama models, never cloud APIs.
# Set to false to re-enable Claude Code / OpenAI.
LOCAL_ONLY=true
# Seconds to wait for an Ollama response (first model load can be slow)
OLLAMA_TIMEOUT=600
